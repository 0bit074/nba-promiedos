# Fuente de datos: "espn" (datos reales, valor por defecto) o "mock" (datos de prueba)
NBA_DATA_SOURCE=espn

# Opcional: dirección pública del sitio (por defecto, https://the-rookie-app.vercel.app).
NEXT_PUBLIC_SITE_URL=

# --- Notificaciones push (marcador en vivo y recordatorios) ---

# Clave privada de Web Push: la pareja de VAPID_PUBLIC_KEY (src/lib/site.ts).
VAPID_PRIVATE_KEY=

# Opcional: quién envía los push (una URL o "mailto:"). Por defecto, la del sitio.
VAPID_SUBJECT=

# Secreto que debe mandar el programador externo al llamar a /api/push/cron
# (header "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Base de datos Redis (Upstash). Al conectarla desde Vercel se cargan solas.
# Sin ellas, en desarrollo se usa memoria y en producción el push queda apagado.
KV_REST_API_URL=
KV_REST_API_TOKEN=
